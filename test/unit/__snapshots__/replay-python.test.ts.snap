    @classmethod
    def from_storage_state(cls, path: str | Path, values: dict[str, str] | None = None) -> Session:
        data = json.loads(Path(path).read_text("utf-8"))
        cookies = data.get("cookies", []) if isinstance(data, dict) else []
        return cls(cookies if isinstance(cookies, list) else [], values)

