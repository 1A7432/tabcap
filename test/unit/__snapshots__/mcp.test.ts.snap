exports[`tools/list --all-tools: generated from the command table navigate's inputSchema (snapshot) 1`] = `
{
  "description": "load a URL in the session's tab (opens a background tab if needed), wait until ready and the DOM is quiet → tab, url, title, readyState, nav, status (the HTTP status of the main document the tab shows, the last hop of a redirect; null for about:blank and error pages)",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "newTab": {
        "description": "open a new background tab (it becomes the session's current tab)",
        "type": "boolean",
      },
      "noWait": {
        "description": "return right after the action: skip the post-action wait (a navigation it starts, then 100 ms without DOM changes; 3 s at most, longer under emulate throttling)",
        "type": "boolean",
      },
      "session": {
        "default": "default",
        "description": "session name; else $TABCAP_SESSION",
        "type": "string",
      },
      "tab": {
        "description": "act on this tab of the session (e.g. a popup from \`tabcap tab list\`) instead of its current tab",
        "type": "string",
      },
      "timeout": {
        "default": 30000,
        "description": "command timeout in ms",
        "type": "number",
      },
      "url": {
        "description": "<url> in \`tabcap navigate <url> [--tab t2] [--new-tab] [--no-wait]\`",
        "type": "string",
      },
    },
    "required": [
      "url",
    ],
    "type": "object",
  },
  "name": "tabcap_navigate",
}
`;
