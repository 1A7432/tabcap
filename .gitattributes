# Check out LF everywhere (Windows CI included): fixtures, docs and generated
# tables are compared byte for byte, and bundle files are hashed.
* text=auto eol=lf
# Bundle blobs are content-addressed bytes: never convert them.
fixtures/bundles/**/blobs/** -text
# Wire fixtures are raw wire bytes (an HTTP/1.1 head is all text, CRLF included): never convert them.
native/wireprint/fixtures/**/*.bin -text
