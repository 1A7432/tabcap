{
  "name": "tabcap",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "bun test test/unit",
    "test:range": "echo 'range not implemented' && exit 0",
    "test:e2e": "TABCAP_E2E=1 bun test test/e2e --timeout 120000",
    "gen:docs": "bun scripts/gen-docs.ts",
    "validate:skill": "bun scripts/validate-skill.ts skills/tabcap",
    "typecheck": "tsc --noEmit -p .",
    "verify": "bun run test && echo 'matrix: A1-A6 not implemented (L0 only)'",
    "build": "bun build --compile src/cli/main.ts --outfile dist/tabcap",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/cli/main.ts --outfile dist/tabcap-darwin-arm64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 src/cli/main.ts --outfile dist/tabcap-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/cli/main.ts --outfile dist/tabcap-linux-arm64",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 src/cli/main.ts --outfile dist/tabcap-windows-x64.exe",
    "release": "bun scripts/release.ts",
    "release:darwin-arm64": "bun scripts/release.ts --targets darwin-arm64"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
